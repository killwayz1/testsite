# Используем официальный образ PHP с веб-сервером Apache
FROM php:8.2-apache

# Копируем все файлы нашего сайта в рабочую директорию Apache на сервере
COPY . /var/www/html/

# Включаем модуль перенаправления Apache (полезно для красивых URL)
RUN a2enmod rewrite

# Открываем 80-й порт для веб-трафика
EXPOSE 80